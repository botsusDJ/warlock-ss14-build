# _Warlock — мехи Братства Стали.

## ================================================================================================
## Гнёзда узлов
##
## Названия короткие: они подставляются в перечисления «не хватает: ...», и полные
## обороты там превращаются в кашу.
## ================================================================================================
warlock-mech-slot-cockpit = кабина
warlock-mech-slot-reactor = реактор
warlock-mech-slot-hip_l = левое основание
warlock-mech-slot-hip_r = правое основание
warlock-mech-slot-knee_l = левое колено
warlock-mech-slot-knee_r = правое колено
warlock-mech-slot-foot_l = левая ступня
warlock-mech-slot-foot_r = правая ступня
warlock-mech-slot-leg_a = передняя левая лапа
warlock-mech-slot-leg_b = передняя правая лапа
warlock-mech-slot-leg_c = задняя левая лапа
warlock-mech-slot-leg_d = задняя правая лапа
warlock-mech-slot-claw_l = левый бур
warlock-mech-slot-claw_r = правый бур
warlock-mech-slot-mount_l = левый пилон
warlock-mech-slot-mount_r = правый пилон

## ================================================================================================
## Осмотр рамы
## ================================================================================================
warlock-mech-examine-lube = Смазка: { $pct }%.
warlock-mech-examine-missing = Не хватает узлов: { $slots }.
warlock-mech-examine-wear = Узлы изношены на { $pct }%.
warlock-mech-examine-crewed = В кабине двое: за рычагами и за прицелами.
warlock-mech-examine-solo-drive = Один за рычагами. Прицелы пустуют.
warlock-mech-examine-solo-gun = Один за прицелами. Рычаги брошены.

## ================================================================================================
## Экипаж и посты
## ================================================================================================
warlock-mech-verb-gunner-in = Занять место стрелка
warlock-mech-verb-gunner-out = Слезть с места стрелка
warlock-mech-verb-remove = Снять: { $part }
warlock-mech-gunner-in = Вы втискиваетесь за прицелы.
warlock-mech-gunner-out = Вы выбираетесь наружу.
warlock-mech-station-drive = Вы беретесь за рычаги. Орудия молчат.
warlock-mech-station-gun = Вы разворачиваетесь к прицелам. Рама встаёт.
warlock-mech-station-crewed = Прицелы заняты стрелком. Ваше место — рычаги.

## ================================================================================================
## Смазка
## ================================================================================================
warlock-mech-grease-empty = Канистра пуста.
warlock-mech-grease-full = Заливать больше некуда.
warlock-mech-grease-poured = Залито смазки: { $amount }.
warlock-mech-dry = Суставы начинают скрежетать. Смазка на исходе.

## ================================================================================================
## Узлы
## ================================================================================================
warlock-mech-part-examine = Гнездо: { $slot }.
warlock-mech-part-dirt = Забит грязью на { $pct }%.
warlock-mech-part-melt = Оплавлен на { $pct }%. Это уже не отмоется.
warlock-mech-part-installed = { $part } встаёт на место.
warlock-mech-part-torn = С рамы срывает узел: { $part }!
warlock-mech-part-wrong-chassis = Узел не от этой рамы.
warlock-mech-part-no-slot = Этой раме такой узел некуда ставить.
warlock-mech-part-slot-taken = Гнездо уже занято.
warlock-mech-part-cleaned = Вы счищаете грязь.
warlock-mech-part-clean-already = Чистить нечего.
warlock-mech-rag-spent = Ветошь расползается в руках.

## ================================================================================================
## Сборка
## ================================================================================================
warlock-mech-frame-ready = Все гнёзда заняты. Осталось замкнуть.
warlock-mech-frame-missing = Пустуют гнёзда: { $slots }.
warlock-mech-frame-installed = Узел встал. Осталось гнёзд: { $left }.
warlock-mech-frame-done = Рама сходится в { $mech }.
